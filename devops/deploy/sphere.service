[Unit]
Description=Sphere Application
After=network.target

[Service]
Type=simple
ExecStart=/opt/sphere/app --config /opt/sphere/config.json
WorkingDirectory=/opt/sphere
# Run as an unprivileged user that owns WorkingDirectory, e.g.:
#   sudo useradd --system --home /opt/sphere sphere && sudo chown -R sphere: /opt/sphere
User=sphere
Group=sphere
Restart=always
RestartSec=5
Environment="GIN_MODE=release"
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target