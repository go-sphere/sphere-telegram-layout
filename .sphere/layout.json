{
  "schema_version": 1,
  "name": "telegram",
  "upstream": {
    "repository": "https://github.com/go-sphere/sphere-telegram-layout.git",
    "ref": "master",
    "module": "github.com/go-sphere/sphere-telegram-layout"
  },
  "capabilities": [
    "protobuf",
    "gin-http",
    "ent",
    "wire",
    "swagger",
    "typescript-client",
    "dashboard",
    "password-auth",
    "local-storage",
    "telegram-bot"
  ],
  "ownership": {
    "layout_owned": [
      ".github/workflows/**",
      ".dockerignore",
      ".gitignore",
      ".sphere/layout.json",
      "AGENTS.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "buf.gen.yaml",
      "buf.binding.yaml",
      "buf.yaml",
      "cmd/app/Dockerfile",
      "cmd/tools/**",
      "docs/docs.*.go",
      "internal/pkg/app/**",
      "internal/pkg/httpsrv/**",
      "scripts/**"
    ],
    "mixed": [
      "Makefile",
      "cmd/app/builder.go",
      "cmd/app/main.go",
      "cmd/app/wire.go",
      "go.mod",
      "internal/*/wire.go",
      "internal/config/**",
      "internal/pkg/database/schema/**",
      "internal/server/bot/**",
      "internal/server/dash/**",
      "internal/service/bot/**",
      "internal/service/dash/auth.go",
      "internal/wire.go",
      "proto/bot/**"
    ],
    "generated": [
      "api/**",
      "build/**",
      "swagger/**",
      "var/**",
      "config.json",
      "config_gen.json",
      "buf.lock",
      "go.sum",
      "cmd/app/wire_gen.go",
      "proto/entpb/entpb.proto",
      "internal/pkg/database/ent/**",
      "internal/pkg/render/entbind/**",
      "internal/pkg/render/entmap/**"
    ],
    "default": "project_owned"
  }
}
