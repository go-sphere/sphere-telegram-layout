{
  "schema_version": 1,
  "name": "telegram",
  "upstream": {
    "repository": "https://github.com/go-sphere/sphere-telegram-layout.git",
    "ref": "master",
    "module": "github.com/go-sphere/sphere-telegram-layout"
  },
  "capabilities": [
    "protobuf",
    "stdx-http",
    "ent",
    "wire",
    "swagger",
    "typescript-client",
    "dashboard",
    "password-auth",
    "local-storage",
    "telegram-bot"
  ],
  "ownership": {
    "layout_owned": [
      ".github/workflows/**",
      ".dockerignore",
      ".gitignore",
      ".sphere/layout.json",
      "AGENTS.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "buf.gen.yaml",
      "buf.binding.yaml",
      "buf.yaml",
      "cmd/app/Dockerfile",
      "cmd/tools/**",
      "codegen.versions",
      "docs/LAYOUT_CONTRACT.md",
      "docs/docs.*.go",
      "internal/pkg/app/**",
      "internal/pkg/conv/**",
      "internal/pkg/dao/tx.go",
      "internal/pkg/dao/tx_test.go",
      "internal/pkg/database/.gitignore",
      "internal/pkg/database/README.md",
      "internal/pkg/database/client/**",
      "internal/pkg/httpsrv/**",
      "internal/pkg/render/.gitignore",
      "internal/pkg/render/errors.go",
      "internal/pkg/render/errors_test.go",
      "internal/pkg/render/render.go",
      "internal/pkg/scache/**",
      "scripts/**"
    ],
    "mixed": [
      "Makefile",
      "assets/dash/**",
      "cmd/app/builder.go",
      "cmd/app/main.go",
      "cmd/app/wire.go",
      "devops/**",
      "docker-compose.yaml",
      "go.mod",
      "internal/biz/wire.go",
      "internal/pkg/wire.go",
      "internal/server/wire.go",
      "internal/service/wire.go",
      "internal/config/**",
      "internal/pkg/database/schema/**",
      "internal/pkg/render/entpb.go",
      "internal/server/bot/**",
      "internal/server/dash/**",
      "internal/service/bot/**",
      "internal/service/dash/auth.go",
      "internal/wire.go",
      "proto/bot/**"
    ],
    "generated": [
      "api/**",
      "build/**",
      "swagger/**",
      "var/**",
      "config.json",
      "config_gen.json",
      "buf.lock",
      "go.sum",
      "codegen.sha256",
      "cmd/app/wire_gen.go",
      "proto/entpb/entpb.proto",
      "internal/pkg/database/ent/**",
      "internal/pkg/render/entbind/**",
      "internal/pkg/render/entmap/**"
    ],
    "default": "project_owned"
  }
}
